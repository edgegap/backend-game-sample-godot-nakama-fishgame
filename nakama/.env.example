# Copy to .env (never commit .env: it holds your Edgegap API token).

# Edgegap dashboard > User Settings > Tokens. Keep the "token " prefix.
EDGEGAP_API_TOKEN=token 00000000-0000-0000-0000-000000000000
# The Edgegap application and the version Nakama deploys first.
EDGEGAP_APPLICATION=fishgame-godot
INITIAL_EDGEGAP_VERSION=1.0.0
# Port name in that app version (UDP 7777 inside the container).
EDGEGAP_PORT_NAME=gameport

# Public https URL of this Nakama. Edgegap servers call it back, so localhost
# won't do: use your Nakama host, or a tunnel to port 7350 for testing.
NAKAMA_ACCESS_URL=https://your-nakama.example.com
# Server-to-server key; game servers get it inside their callback URLs.
NAKAMA_HTTP_KEY=change-me-to-a-long-random-string

# Automated tests only: servers hit one fish per round so matches finish alone.
FISHGAME_TEST_AUTO_HIT=false
